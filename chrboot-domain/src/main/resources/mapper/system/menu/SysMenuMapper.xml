<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chr.domain.system.menu.db.mapper.SysMenuMapper">

    <resultMap id="BaseResultMap" type="com.chr.domain.system.menu.db.SysMenuEntity">
            <id property="menuId" column="menu_id" />
            <result property="menuName" column="menu_name" />
            <result property="menuType" column="menu_type" />
            <result property="routerName" column="router_name" />
            <result property="parentId" column="parent_id" />
            <result property="path" column="path" />
            <result property="isButton" column="is_button" />
            <result property="permission" column="permission" />
            <result property="metaInfo" column="meta_info" />
            <result property="remark" column="remark" />
            <result property="status" column="status" />
            <result property="isDeleted" column="is_deleted" />
            <result property="createTime" column="create_time" />
            <result property="updateTime" column="update_time" />
            <result property="createUser" column="create_user" />
            <result property="updateUser" column="update_user" />
    </resultMap>

    <sql id="Base_Column_List">
        menu_id,menu_name,menu_type,router_name,parent_id,path,
        is_button,permission,meta_info,remark,status,
        is_deleted,create_time,update_time,create_user,update_user
    </sql>

    <select id="selectPermissionsByUserId" resultType="string">
        SELECT DISTINCT m.`permission`
        FROM sys_role_user ru
                 LEFT JOIN sys_role r ON r.`role_id` = ru.`role_id`
                 LEFT JOIN sys_role_menu rm ON rm.`role_id` = r.`role_id`
                 LEFT JOIN sys_menu m ON m.`menu_id` = rm.`menu_id`
        WHERE user_id = #{userId}
    </select>

    <select id="selectRoutesByUserId" resultMap="BaseResultMap">
        SELECT m.menu_id, m.menu_name, m.menu_type, m.router_name, m.parent_id, m.path, m.is_button, m.permission, m.meta_info, m.remark, m.status, m.is_deleted, m.create_time, m.update_time, m.create_user, m.update_user
        FROM sys_role_user ru
                 LEFT JOIN sys_role r ON r.`role_id` = ru.`role_id`
                 LEFT JOIN sys_role_menu rm ON rm.`role_id` = r.`role_id`
                 LEFT JOIN sys_menu m ON m.`menu_id` = rm.`menu_id`
        WHERE user_id = #{userId} AND M.is_button=0
    </select>
</mapper>
